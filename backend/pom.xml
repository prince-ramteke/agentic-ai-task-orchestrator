<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot version: 3.4.1 (see docs/ADR/0001-technology-baseline.md).
      Chosen because it is the officially-aligned platform for springdoc-openapi 2.7.0,
      is fully compatible with Java 21, and keeps the door open for Spring AI 1.0.x and
      Spring Security 6.4.x in later milestones.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.prince.agentic</groupId>
    <artifactId>agentic-ai-task-orchestrator</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Agentic AI Task Orchestrator :: Backend</name>
    <description>M10 — observability and audit retention for the Agentic AI Task Orchestrator.</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Keep third-party versions centralized and intentional. -->
        <springdoc.version>2.7.0</springdoc.version>
        <!-- JJWT: single, cohesive JWT library (HS256). See docs/ADR/0004-jwt-authentication-strategy.md. -->
        <jjwt.version>0.12.6</jjwt.version>
        <!-- Spring AI: 1.0.x is the line compatible with Spring Boot 3.4.x (1.1.x needs 3.5, 2.x needs Boot 4).
             The BOM governs only spring-ai-* artifacts; the Boot parent stays 3.4.1. See ADR-0009. -->
        <spring-ai.version>1.0.9</spring-ai.version>
    </properties>

    <!-- Import the Spring AI BOM so spring-ai-* artifact versions are managed centrally.
         This does NOT change the Spring Boot version (inherited from the parent). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web (REST) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator (health / info / prometheus) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- === Milestone 10: Prometheus scrape endpoint ===
             Adds /actuator/prometheus. Version managed by the Spring Boot BOM. No provider is deployed
             here — the app simply becomes compatible with a scrape-based collector (ADR-0030). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Bean Validation foundation for request DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger UI (aligned with Spring Boot 3.4.x) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- === Milestone 4: Spring AI (LLM integration) ===
             Provider abstraction over a local Ollama runtime. Version from spring-ai-bom (1.0.9).
             No tool-calling/function modules, no vector store, no Redis — those arrive with M5/M7. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!-- === Milestone 7: Redis conversation memory ===
             Ephemeral, bounded, TTL'd conversation context (Lettuce, via Spring Boot auto-config).
             Never a replacement for PostgreSQL; no durable data lives only in Redis (docs/MEMORY.md). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- === Milestone 2: Authentication & Authorization === -->

        <!-- Spring Security (JWT auth, RBAC, method security) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Persistence for the security domain (users/roles) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Versioned schema migrations -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- PostgreSQL driver (local/prod runtime) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JWT (HS256) — one library, no overlap -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2 in PostgreSQL-compat mode: runs the SAME Flyway migrations without Docker,
             so the security suite is reproducible in any environment (ADR-0005).
             Testcontainers-PostgreSQL integration is deferred to M3. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- === Milestone 3: real-PostgreSQL integration tests (versions managed by the Spring Boot BOM) ===
             Verify the actual Flyway migrations + JPA mappings against real PostgreSQL. The *IT tests
             skip cleanly (disabledWithoutDocker) when no Docker engine is present, so `mvn verify`
             stays green everywhere while running for real in Docker-capable environments (ADR-0008). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- M7: real-Redis integration tests via a generic redis:7-alpine container (no dedicated
             Testcontainers module needed). Skips cleanly without Docker, like the *IT PostgreSQL tests. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Still deliberately NOT added (arrive with the milestone that needs them):
            - kafka / prometheus / grafana infra  (later milestones)
          Persistence (JPA/PostgreSQL/Flyway) and Spring Security were added in M2 because
          the authentication domain genuinely requires them (supersedes ADR-0002 for security data).
        -->
    </dependencies>

    <build>
        <!-- Filter application*.yml so @project.version@ resolves to the real build version (honest version reporting). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>application*.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>application*.yml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Failsafe runs the Testcontainers integration tests (*IT) in the integration-test/verify
              phases; surefire keeps running the fast unit + H2 functional suite (*Test). ITs that are
              disabled without Docker are reported as skipped, not failed, so `mvn verify` stays green.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!--
                      Pin the Docker Remote API version for docker-java/Testcontainers. The docker-java
                      client bundled with Testcontainers 1.20.x negotiates an API version newer than
                      Docker Engine 29 accepts (max 1.54), so its /info probe fails with HTTP 400 and
                      Testcontainers reports "no valid Docker environment". 1.44 is within every modern
                      engine's supported range (server min here is 1.40), so this is portable across
                      local Docker Desktop and Linux CI. Without Docker, ITs still skip via
                      @Testcontainers(disabledWithoutDocker = true).
                    -->
                    <systemPropertyVariables>
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              JaCoCo: coverage REPORTING only in Milestone 1 (no enforcement gate yet).
              Enforcement thresholds are activated in Milestone 3 once real domain logic
              exists (see docs/TESTING.md). This keeps `mvn verify` green and honest.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <!--
                  Coverage is measured from the surefire (*Test) suite, which exercises
                  controllers/services/mappers/entities/security on H2 — so the gate holds even
                  when the Docker-gated *IT tests are skipped. Excludes keep the gate focused on
                  business logic rather than scaffolding: the bootstrap class, config, and record
                  DTOs/response envelopes (compiler-generated accessors, no branches to test).
                -->
                <configuration>
                    <excludes>
                        <exclude>com/prince/agentic/AgenticApplication.class</exclude>
                        <exclude>com/prince/agentic/config/**</exclude>
                        <exclude>**/dto/**</exclude>
                        <exclude>com/prince/agentic/common/response/**</exclude>
                        <!-- M4: provider-specific wiring/config (infra, exercised by the gated live IT, not unit-tested). -->
                        <exclude>com/prince/agentic/ai/config/**</exclude>
                        <exclude>com/prince/agentic/ai/llm/ollama/**</exclude>
                        <!-- M5: thin tool catalog controller/DTOs (covered by ToolCatalogApiTest, not unit logic). -->
                        <exclude>com/prince/agentic/tool/api/**</exclude>
                        <!-- M7: memory wiring (config only; the service/bounds/model ARE unit-tested). -->
                        <exclude>com/prince/agentic/memory/MemoryConfig.class</exclude>
                        <!-- M10: observability wiring (filter registration only; the filter IS unit-tested). -->
                        <exclude>com/prince/agentic/common/observability/ObservabilityConfig.class</exclude>
                        <!-- M10: retention scheduling wiring (no business logic; the job IS unit-tested). -->
                        <exclude>com/prince/agentic/audit/retention/SchedulingConfig.class</exclude>
                        <!-- H-01: auth rate-limit wiring (filter IS unit-tested; config is pure wiring). -->
                        <exclude>com/prince/agentic/auth/ratelimit/AuthRateLimitConfig.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.65</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
