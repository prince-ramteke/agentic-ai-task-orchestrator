# Agentic AI Task Orchestrator — environment template
# Copy to `.env` (git-ignored) and fill with LOCAL values. NEVER commit real secrets.
# Every variable here must also be documented in docs/DEPLOYMENT.md.

# --- Runtime profile ---
# Maps to SPRING_PROFILES_ACTIVE. Default is 'local'.
ACTIVE_PROFILE=local          # local | docker | test

# --- PostgreSQL (durable application data) --- REQUIRED as of M2 (users/roles) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/agentic
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Redis (agent conversation memory) --- IMPLEMENTED as of M7 ---
# Ephemeral, bounded, TTL'd conversation context (docs/MEMORY.md). Never durable domain data.
# Leave REDIS_PASSWORD blank for local dev; set it in non-dev environments (never commit a real value).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Security --- REQUIRED as of M2 ---
# JWT_SECRET must be at least 32 characters (256 bits) for HS256. Generate a strong random
# value locally (e.g. `openssl rand -base64 48`); do not reuse across environments or commit it.
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
# Comma-separated allowed CORS origins (the frontend origin[s]). No wildcard with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- LLM provider (Spring AI) --- IMPLEMENTED as of M4 (Ollama only; openai is future) ---
LLM_PROVIDER=ollama           # ollama (only wired provider in M4)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2         # local default; must be pulled: `ollama pull llama3.2`
OLLAMA_TEMPERATURE=0.2        # 0.0–1.0; lower = more deterministic
OLLAMA_TIMEOUT_SECONDS=60     # connect + read timeout for LLM calls (fail fast, no indefinite wait)

# Optional cloud fallback — OFF by default and NOT wired in M4. Only enable if a data-privacy
# review allows it (see docs/DATA_PRIVACY.md). Present here as a documented future capability.
LLM_FALLBACK_ENABLED=false
OPENAI_API_KEY=

# --- Agent execution bounds (guardrails) --- IMPLEMENTED as of M6 (AgentProperties) ---
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=10
AGENT_TIMEOUT_SECONDS=60
AGENT_LOOP_THRESHOLD=2
AGENT_MAX_OBSERVATION_CHARS=2000
AGENT_MAX_ARRAY_ITEMS=20
# AGENT_MAX_RETRIES=2   # PLANNED (M8): step retry limit. M6 does one bounded *decision* repair only
#                       # and never auto-retries side-effecting tools — not yet enforced.

# --- Agent conversation memory (Redis) --- IMPLEMENTED as of M7 (MemoryProperties) ---
# Sliding TTL, refreshed on every turn. Two bounds: storage (what Redis keeps) and context
# (the smaller slice rendered into the LLM prompt — the full history is never sent to the model).
AGENT_MEMORY_TTL_SECONDS=86400          # 24h sliding expiration
AGENT_MEMORY_MAX_MESSAGES=50            # storage: max messages kept per conversation
AGENT_MEMORY_MAX_CHARS=12000           # storage: max total content chars kept
AGENT_MEMORY_CONTEXT_MAX_MESSAGES=12    # context: max prior messages rendered into the prompt
AGENT_MEMORY_CONTEXT_MAX_CHARS=6000    # context: max chars rendered into the prompt

# --- Observability ---
METRICS_ENABLED=true

# --- Testing note (not a runtime variable) ---
# The Testcontainers integration tests (*IT) require a running Docker engine and start real
# PostgreSQL (postgres:16-alpine) and Redis (redis:7-alpine) containers. Without Docker,
# `./mvnw verify` still passes (those tests skip via a Docker assumption). No new runtime
# environment variables are required for M7 beyond the REDIS_* and AGENT_MEMORY_* keys above.
