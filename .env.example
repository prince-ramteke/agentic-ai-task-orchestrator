# Agentic AI Task Orchestrator — environment template
# Copy to `.env` (git-ignored) and fill with LOCAL values. NEVER commit real secrets.
# Every variable here must also be documented in docs/DEPLOYMENT.md.

# --- Runtime profile ---
ACTIVE_PROFILE=dev            # dev | docker | test

# --- PostgreSQL (durable application data) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/agentic
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Redis (conversation/session/execution state, caching) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Security ---
# Generate a strong random value locally; do not reuse across environments.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=30

# --- LLM provider (Spring AI) ---
LLM_PROVIDER=ollama           # ollama | openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional cloud fallback — OFF by default. Only enable if data-privacy review allows it.
LLM_FALLBACK_ENABLED=false
OPENAI_API_KEY=

# --- Agent execution bounds (guardrails) ---
AGENT_MAX_TOOL_CALLS=10
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_RETRIES=2

# --- Observability ---
METRICS_ENABLED=true
